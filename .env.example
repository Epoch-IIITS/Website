# Database (must be a replica set for audited/admin team writes)
MONGODB_URI=mongodb://localhost:27017/epoch?replicaSet=rs0&directConnection=true

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Comma-separated; applied when an account is first created
ADMIN_EMAILS=developer@example.com

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
