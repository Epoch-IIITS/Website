  "entry_point": "read_json(headers, body); validate_item(data); json_response(status, payload)",
  "hints": [
    "`media = headers.get(\"content-type\", \"\").split(\";\")[0].strip().lower()`; catch `json.JSONDecodeError`.",
    "A number check: `isinstance(x, (int, float)) and not isinstance(x, bool)`.",
    "Extra fields: `sorted(set(data) - {\"name\", \"price\", \"tags\"})`; append one error per field."
  ],
  "failure_feedback": [
    {
      "test": "test_read_ok_with_charset",
      "advice": "Compare only the media type before ';', lowercased and stripped."
    },
    {
      "test": "test_read_415",
      "advice": "A missing or non-JSON Content-Type gives 415."
    },
    {
      "test": "test_read_400",
      "advice": "Catch `json.JSONDecodeError` and return 400."
    },
    {
      "test": "test_all_errors_reported",
      "advice": "Collect every error in the order name, price, tags, then sorted extra fields."
    },
    {
      "test": "test_required_and_bool",
      "advice": "Report missing fields as 'field required' and reject booleans as numbers."
    },
    {
      "test": "test_json_response",
      "advice": "Use `separators=(\",\", \":\")` for compact JSON."
    }
  ],
